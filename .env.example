# Local-only runtime and validation configuration template
# Copy this file to `.env` on your machine and fill the local-only secret values there.
# Never commit the real `.env` file.

# ===== Real LLM / donor validation =====
OPENAI_API_KEY=__FILL_REAL_OPENAI_API_KEY__
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ===== Real validation inputs =====
REAL_VALIDATION_DOCUMENT_PATH=__FILL_REAL_DOCUMENT_PATH__
REAL_VALIDATION_QUERY=document structure

# ===== Existing runtime settings =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
VECTOR_BACKEND=pgvector
TREE_STRATEGY=auto_merging
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
MILVUS_URL=http://localhost:19530
